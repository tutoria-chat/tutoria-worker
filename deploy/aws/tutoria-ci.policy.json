{
  "Version": "2012-10-17",
  "Statement": [
    { "Sid": "EcrLogin", "Effect": "Allow", "Action": "ecr:GetAuthorizationToken", "Resource": "*" },
    {
      "Sid": "EcrTutoriaRepos",
      "Effect": "Allow",
      "Action": [
        "ecr:DescribeRepositories", "ecr:CreateRepository", "ecr:PutLifecyclePolicy",
        "ecr:BatchCheckLayerAvailability", "ecr:InitiateLayerUpload", "ecr:UploadLayerPart",
        "ecr:CompleteLayerUpload", "ecr:PutImage", "ecr:BatchGetImage", "ecr:GetDownloadUrlForLayer"
      ],
      "Resource": [
        "arn:aws:ecr:us-east-2:061100493246:repository/tutoria-dotnet-api",
        "arn:aws:ecr:us-east-2:061100493246:repository/tutoria-ai-api-*",
        "arn:aws:ecr:us-east-2:061100493246:repository/tutoria-worker-*"
      ]
    },
    { "Sid": "AppRunnerList", "Effect": "Allow", "Action": "apprunner:ListServices", "Resource": "*" },
    {
      "Sid": "AppRunnerDotnetApi",
      "Effect": "Allow",
      "Action": ["apprunner:CreateService", "apprunner:UpdateService", "apprunner:DescribeService", "apprunner:ListOperations", "apprunner:TagResource"],
      "Resource": "arn:aws:apprunner:us-east-2:061100493246:service/tutoria-dotnet-api-*"
    },
    { "Sid": "EcsExpress", "Effect": "Allow", "Action": "ecs:*", "Resource": "*" },
    {
      "Sid": "PassOnlyTheTutoriaRoles",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": [
        "arn:aws:iam::061100493246:role/ecsTaskExecutionRole",
        "arn:aws:iam::061100493246:role/ecsInfrastructureRoleForExpressServices",
        "arn:aws:iam::061100493246:role/TutoriaAppRunnerArn",
        "arn:aws:iam::061100493246:role/TutoriaAppRunnerInstance"
      ],
      "Condition": { "StringLike": { "iam:PassedToService": ["ecs-tasks.amazonaws.com", "ecs.amazonaws.com", "apprunner.amazonaws.com", "tasks.apprunner.amazonaws.com", "build.apprunner.amazonaws.com"] } }
    }
  ]
}
