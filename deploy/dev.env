# Where this repo deploys: a push to main for dev, the Deploy PROD run for prod.
# Changed by a commit, so the current value is always here to read.
# RAILWAY: the old host (SQS queues). AWS: ECS (needs the owner's ECS roles and
# /tutoria/dev/worker/ in SSM first). AZURE: Container Apps (Postgres job runner).
RAILWAY=true
AWS=false
AZURE=true

# Azure ids, printed by tutoria-api/infra/azure/deploy.sh. Identifiers, not secrets.
AZURE_TENANT_ID=6e66b3cc-bd70-42bf-946b-4e5e843df744
AZURE_SUBSCRIPTION_ID=b0954dd4-3c77-4a35-ad46-067714238e11
AZURE_CLIENT_ID=2af2abc4-9b2f-483c-aed3-879b47f24637
AZURE_REGISTRY=tutoriadevtt7q
AZURE_RESOURCE_GROUP=tutoria-dev
