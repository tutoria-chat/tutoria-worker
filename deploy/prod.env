# Where this repo deploys: a push to main for dev, the Deploy PROD run for prod.
# Changed by a commit, so the current value is always here to read.
# RAILWAY: the old host (SQS queues). AWS: ECS (needs the owner's ECS roles and
# /tutoria/prod/worker/ in SSM first). AZURE: Container Apps (Postgres job runner).
# Prod flips the same way as dev (RAILWAY=false, AWS=true) once dev is green: owner's call.
RAILWAY=false
AWS=true
AZURE=false

# AWS ids (identifiers, not secrets). GitHub signs in with OIDC: the role trusts
# this repo's main branch (dev) / "production" environment (prod).
AWS_DEPLOY_ROLE_ARN=arn:aws:iam::061100493246:role/tutoria-ci
ECS_TASK_EXECUTION_ROLE_ARN=arn:aws:iam::061100493246:role/ecsTaskExecutionRole
ECS_INFRASTRUCTURE_ROLE_ARN=arn:aws:iam::061100493246:role/ecsInfrastructureRoleForExpressServices
# The same task role as tutoria-ai-api (SSM /tutoria/*, S3, DynamoDB, SQS).
ECS_TASK_ROLE_ARN=arn:aws:iam::061100493246:role/TutoriaAppRunnerArn

# Azure ids, printed by tutoria-api/infra/azure/deploy.sh. Identifiers, not secrets.
AZURE_TENANT_ID=
AZURE_SUBSCRIPTION_ID=
AZURE_CLIENT_ID=
AZURE_REGISTRY=
AZURE_RESOURCE_GROUP=tutoria-prod
