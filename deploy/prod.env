# Where this repo deploys: a push to main for dev, the Deploy PROD run for prod.
# Changed by a commit, so the current value is always here to read.
# RAILWAY: the old host (SQS queues). AWS: ECS (needs the owner's ECS roles and
# /tutoria/prod/worker/ in SSM first). AZURE: Container Apps (Postgres job runner).
RAILWAY=true
AWS=false
AZURE=false

# Azure ids, printed by tutoria-api/infra/azure/deploy.sh. Identifiers, not secrets.
AZURE_TENANT_ID=
AZURE_SUBSCRIPTION_ID=
AZURE_CLIENT_ID=
AZURE_REGISTRY=
AZURE_RESOURCE_GROUP=tutoria-prod
