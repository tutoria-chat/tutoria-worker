# ── tutoria-worker environment variables ──────────────────────────────────────
# Copy to .env and fill in real values. Never commit .env to git.

# ── Database ──────────────────────────────────────────────────────────────────
# Same connection string as tutoria-api (shared PostgreSQL database)
DATABASE_URL=postgresql+psycopg2://user:password@host:5432/tutoria_dev

# ── Security ──────────────────────────────────────────────────────────────────
SECRET_KEY=change-me-to-a-long-random-string
INTERNAL_API_KEY=change-me-must-match-dotnet-api-and-tutoria-api

# ── AWS (S3 file storage) ─────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-2
S3_BUCKET_NAME=tutoria-files-dev
S3_REGION=us-east-2

# ── AI Provider Keys ──────────────────────────────────────────────────────────
# Primary: OpenAI (quiz generation, extraction fallback)
OPENAI_API_KEY=sk-proj-...

# Secondary: Gemini (preferred for document extraction — cheaper & fast)
GEMINI_API_KEY=

# Fallback
DEEPSEEK_API_KEY=

# ── DB-managed API key encryption ────────────────────────────────────────────
# Must match the value used in tutoria-api
USE_DB_PROVIDER_KEYS=true
ENCRYPTION_KEY=

# ── Document Processing ───────────────────────────────────────────────────────
USE_LOCAL_PDF_EXTRACTION=true
FILE_PROCESSING_PROVIDER=gemini
FILE_PROCESSING_FALLBACK_CHAIN=openai
PDF_MAX_CONTEXT_CHARS=50000
DOCUMENT_SUMMARY_THRESHOLD=25000

# ── Application ───────────────────────────────────────────────────────────────
PORT=8001
WEB_CONCURRENCY=1
debug=false
